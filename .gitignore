# Temporary directories
/tmp/
.tmp/
.worktrees/

# Build artifacts
bin/
obj/
.vs/

# Test results and coverage
**/TestResults/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Windows NTFS alternate-data-stream download markers (surface as literal files under WSL)
*:Zone.Identifier

# Node modules
node_modules/
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# NuGet
packages/
*.nupkg

# Secrets — never commit environment files containing API keys or passwords
.env
.env.*
!.env.example
!.env.dev.example

# OpenCode MCP configs — generated from *.example templates by sync-api-key.sh
opencode-mcp.json
.opencode/config.json

# Local runtime byproducts (dev.sh / start.sh / stop.sh)
.server.log
.server.pid

# Disposable review output
findings.json

# Real WhatsApp exports used for local Contact Memory manual verification (PII — never commit)
docs/investigations/whatsapp/*.txt
