# Copy this file to .env.dev and fill in the values.
# .env.dev is excluded from git via .gitignore (.env.* pattern).
# This file overrides environment variables for native Deno execution.
# Unlike .env (used by Docker Compose), .env.dev is sourced by dev.sh.

# Connection to the dev Postgres container running on WSL2 loopback (127.0.0.1, not localhost).
# The DB_PASSWORD value must match the DB_PASSWORD in .env.
DATABASE_URL=postgresql://ai_memory:<DB_PASSWORD>@127.0.0.1:5432/ai_memory

# Generate with: openssl rand -hex 32 (must match .env)
MEMORY_API_KEY=your-api-key-here

# Your OpenRouter API key (must match .env)
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional. Agent-facing credential for /api/workflow (ST-086). An agent holding this
# key may create packets, register runs, record checkpoints and decisions, end runs,
# and read the overview — but is refused with 403 on resolve / attach-evidence /
# complete / add-criterion, so it cannot sign off its own verification.
# Leave blank to run with MEMORY_API_KEY alone (today's behaviour): both the request
# middleware and the startup collision guard test this for truthiness, so an empty
# value is equivalent to unset.
# Must NOT equal MEMORY_API_KEY — the server refuses to start if they match.
# docker-compose.yml forwards this into the `mcp` service explicitly; `mcp-test` omits
# it on purpose, because the process-boundary tests build their child env themselves.
AWCP_AGENT_API_KEY=