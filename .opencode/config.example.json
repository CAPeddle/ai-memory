{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "recover": {
      "template": "The prior session failed. {{error}}"
    }
  },
  "mcp": {
    "ai-memory": {
      "type": "remote",
      "url": "http://localhost:3000/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer YOUR_MEMORY_API_KEY"
      }
    }
  }
}
