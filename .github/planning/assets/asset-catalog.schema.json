{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-memory/asset-catalog.schema.json",
  "title": "Governance Asset Catalog",
  "type": "object",
  "required": [
    "metadata",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at_utc",
        "generated_by",
        "in_scope_asset_types",
        "reserved_future_categories"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "generated_at_utc": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "in_scope_asset_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "reserved_future_categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary",
          "asset_type",
          "status",
          "owners",
          "source_path"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "prompt",
              "instruction",
              "skill"
            ]
          },
          "status": {
            "type": "string"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source_path": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "last_reviewed": {
            "type": "string"
          }
        }
      }
    }
  }
}
